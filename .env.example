# JAYVEERMart Enterprise Configuration Template
# Copy this file to .env and configure your local environment settings

# Admin Notification Recipient
VITE_ADMIN_NOTIFICATION_EMAIL=admin@example.com

# System Sender Address
VITE_FROM_EMAIL=JAYVEERMart <noreply@example.com>

# Optional Resend API Key for live email dispatch (Leave empty for simulated mode)
VITE_RESEND_API_KEY=

# Application Base URL
VITE_APP_URL=http://localhost:5173

